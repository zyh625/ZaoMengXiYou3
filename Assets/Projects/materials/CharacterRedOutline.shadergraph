{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "ac8aa4ee323048c5916b51c51cfec67d",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "SpriteOuterOutline (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -220,
            "y": 80,
            "width": 260,
            "height": 220
        }
    },
    "m_Slots": [
        {
            "m_Id": "30a99a71c1e549f49781cedab976005d"
        },
        {
            "m_Id": "887bc2767bf745ccb45b6b7b5de6add7"
        },
        {
            "m_Id": "69a18404b932452eb13b09376240ab97"
        },
        {
            "m_Id": "84d458797fa543eb9934e6d462ba6c4c"
        },
        {
            "m_Id": "88254d6323d0455fad8942617286e4dc"
        },
        {
            "m_Id": "bd76e8510d15434290ab87e0a0f0cc23"
        },
        {
            "m_Id": "cda6da4ff6054ee3a95f0fcf997e5154"
        }
    ],
    "synonyms": [],
    "m_Precision": 1,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "SpriteOuterOutline",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "// Width is measured in source texture pixels. The controller supplies TexelSize, avoiding unsupported automatic texture-size properties in URP 2D.\nfloat4 source = SAMPLE_TEXTURE2D(SpriteTexture.tex, SpriteTexture.samplerstate, UV);\nfloat neighborAlpha = source.a;\nfloat width = clamp(OutlineWidth, 0.0, 8.0);\nif (width > 0.0)\n{\n    // Eight directions at each pixel radius keep narrow features connected.\n    [loop] for (int ring = 1; ring <= (int)ceil(width); ++ring)\n    {\n        float2 delta = TexelSize.xy * min((float)ring, width);\n        float2 uv0 = UV + delta * float2(1.00000000, 0.00000000);\n        float inside0 = step(0.0, uv0.x) * step(uv0.x, 1.0) * step(0.0, uv0.y) * step(uv0.y, 1.0);\n        neighborAlpha = max(neighborAlpha, SAMPLE_TEXTURE2D(SpriteTexture.tex, SpriteTexture.samplerstate, uv0).a * inside0);\n        float2 uv1 = UV + delta * float2(-1.00000000, 0.00000000);\n        float inside1 = step(0.0, uv1.x) * step(uv1.x, 1.0) * step(0.0, uv1.y) * step(uv1.y, 1.0);\n        neighborAlpha = max(neighborAlpha, SAMPLE_TEXTURE2D(SpriteTexture.tex, SpriteTexture.samplerstate, uv1).a * inside1);\n        float2 uv2 = UV + delta * float2(0.00000000, 1.00000000);\n        float inside2 = step(0.0, uv2.x) * step(uv2.x, 1.0) * step(0.0, uv2.y) * step(uv2.y, 1.0);\n        neighborAlpha = max(neighborAlpha, SAMPLE_TEXTURE2D(SpriteTexture.tex, SpriteTexture.samplerstate, uv2).a * inside2);\n        float2 uv3 = UV + delta * float2(0.00000000, -1.00000000);\n        float inside3 = step(0.0, uv3.x) * step(uv3.x, 1.0) * step(0.0, uv3.y) * step(uv3.y, 1.0);\n        neighborAlpha = max(neighborAlpha, SAMPLE_TEXTURE2D(SpriteTexture.tex, SpriteTexture.samplerstate, uv3).a * inside3);\n        float2 uv4 = UV + delta * float2(0.70710678, 0.70710678);\n        float inside4 = step(0.0, uv4.x) * step(uv4.x, 1.0) * step(0.0, uv4.y) * step(uv4.y, 1.0);\n        neighborAlpha = max(neighborAlpha, SAMPLE_TEXTURE2D(SpriteTexture.tex, SpriteTexture.samplerstate, uv4).a * inside4);\n        float2 uv5 = UV + delta * float2(-0.70710678, 0.70710678);\n        float inside5 = step(0.0, uv5.x) * step(uv5.x, 1.0) * step(0.0, uv5.y) * step(uv5.y, 1.0);\n        neighborAlpha = max(neighborAlpha, SAMPLE_TEXTURE2D(SpriteTexture.tex, SpriteTexture.samplerstate, uv5).a * inside5);\n        float2 uv6 = UV + delta * float2(0.70710678, -0.70710678);\n        float inside6 = step(0.0, uv6.x) * step(uv6.x, 1.0) * step(0.0, uv6.y) * step(uv6.y, 1.0);\n        neighborAlpha = max(neighborAlpha, SAMPLE_TEXTURE2D(SpriteTexture.tex, SpriteTexture.samplerstate, uv6).a * inside6);\n        float2 uv7 = UV + delta * float2(-0.70710678, -0.70710678);\n        float inside7 = step(0.0, uv7.x) * step(uv7.x, 1.0) * step(0.0, uv7.y) * step(uv7.y, 1.0);\n        neighborAlpha = max(neighborAlpha, SAMPLE_TEXTURE2D(SpriteTexture.tex, SpriteTexture.samplerstate, uv7).a * inside7);\n    }\n}\n// Composite the source over the outline, preserving the opaque sprite colors.\nfloat outerAlpha = width > 0.0 ? saturate(neighborAlpha - source.a) * saturate(OutlineColor.a) : 0.0;\nAlpha = saturate(source.a + outerAlpha);\nColor = Alpha > 0.00001 ? (source.rgb * source.a + OutlineColor.rgb * outerAlpha) / Alpha : float3(0.0, 0.0, 0.0);\n"
}

