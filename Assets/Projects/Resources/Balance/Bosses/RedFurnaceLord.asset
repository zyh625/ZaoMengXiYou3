  - key: RedFurnaceLordCombat.SampleFrame.1
    label: SampleFrame / if (CurrentSkill == 0) pestleImpact.Play(transform.position,
      pestleRadius * 2f, AttackFaceRight, effectDuration);
    source: Assets/Projects/Scripts/Boss/RedFurnaceLord/RedFurnaceLordCombat.cs:126
    value: 2
  - key: RedFurnaceLordCombat.SampleFrame.2
    label: 'SampleFrame / else if (CurrentSkill == 1) furnaceBreath.Play(Muzzle +
      Vector2.right * (AttackFaceRight ? 1 : -1) * breathRange * '
    source: Assets/Projects/Scripts/Boss/RedFurnaceLord/RedFurnaceLordCombat.cs:127
    value: 0.5
  - key: RedFurnaceLordCombat.SampleFrame.3
    label: 'SampleFrame / else chainSweepArc.Play((Vector2)transform.position + new
      Vector2((AttackFaceRight ? 1 : -1) * chainRange * .5f, at'
    source: Assets/Projects/Scripts/Boss/RedFurnaceLord/RedFurnaceLordCombat.cs:128
    value: 0.5
  - key: RedFurnaceLordCombat.SampleFrame.4
    label: 'SampleFrame / else chainSweepArc.Play((Vector2)transform.position + new
      Vector2((AttackFaceRight ? 1 : -1) * chainRange * .5f, at'
    source: Assets/Projects/Scripts/Boss/RedFurnaceLord/RedFurnaceLordCombat.cs:128
    value: 0.5
  - key: RedFurnaceLordCombat.Pull.1
    label: Pull / if (hits[i].normal.x * Mathf.Sign(dx) < -.1f)
    source: Assets/Projects/Scripts/Boss/RedFurnaceLord/RedFurnaceLordCombat.cs:164
    value: 0.1
  - key: RedFurnaceLordCombat.Pull.2
    label: Pull / dx = Mathf.Sign(dx) * Mathf.Min(Mathf.Abs(dx), Mathf.Max(0f, hits[i].distance
      - .02f));
    source: Assets/Projects/Scripts/Boss/RedFurnaceLord/RedFurnaceLordCombat.cs:165
    value: 0.02
  - key: RedFurnaceLordCombat.EndCore.1
    label: EndCore / coreBurst.Play((Vector2)transform.position + Vector2.up, burstRadius
      * 2f, AttackFaceRight, effectDuration);
    source: Assets/Projects/Scripts/Boss/RedFurnaceLord/RedFurnaceLordCombat.cs:201
    value: 2
  - key: RedFurnaceLordCombat.Update.1
    label: Update / if (coreActive) while (auraElapsed + .0001f >= Mathf.Max(.01f,
      auraTick))
    source: Assets/Projects/Scripts/Boss/RedFurnaceLord/RedFurnaceLordCombat.cs:214
    value: 0.0001
  - key: RedFurnaceLordCombat.Update.2
    label: Update / if (coreActive) while (auraElapsed + .0001f >= Mathf.Max(.01f,
      auraTick))
    source: Assets/Projects/Scripts/Boss/RedFurnaceLord/RedFurnaceLordCombat.cs:214
    value: 0.01
  - key: RedFurnaceLordCombat.Update.3
    label: Update / { auraElapsed -= Mathf.Max(.01f, auraTick); AuraTicks++; DamageRadius(auraRadius,
      auraDamage, false); }
    source: Assets/Projects/Scripts/Boss/RedFurnaceLord/RedFurnaceLordCombat.cs:215
    value: 0.01
  - key: RedFurnaceLordCombat.Update.4
    label: Update / while (breathAccumulator + .0001f >= Mathf.Max(.01f, breathTick))
    source: Assets/Projects/Scripts/Boss/RedFurnaceLord/RedFurnaceLordCombat.cs:226
    value: 0.0001
  - key: RedFurnaceLordCombat.Update.5
    label: Update / while (breathAccumulator + .0001f >= Mathf.Max(.01f, breathTick))
    source: Assets/Projects/Scripts/Boss/RedFurnaceLord/RedFurnaceLordCombat.cs:226
    value: 0.01
  - key: RedFurnaceLordCombat.Update.6
    label: Update / breathAccumulator -= Mathf.Max(.01f, breathTick); BreathTicks++;
    source: Assets/Projects/Scripts/Boss/RedFurnaceLord/RedFurnaceLordCombat.cs:228
    value: 0.01
  - key: RedFurnaceLordEffect.Play.1
    label: Play / transform.localScale = Vector3.one * (width / Mathf.Max(.01f, nativeWidth));
    source: Assets/Projects/Scripts/Boss/RedFurnaceLord/RedFurnaceLordEffect.cs:14
    value: 0.01
  - key: RedFurnaceLordUI.Refresh.1
    label: 'Refresh / ? Mathf.Clamp01(combat.CoreRemaining / Mathf.Max(.01f, combat.CoreDuration))
