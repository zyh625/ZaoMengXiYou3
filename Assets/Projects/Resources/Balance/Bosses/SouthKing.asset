    source: Assets/Projects/Scripts/Boss/SouthKing/SouthIceShield.cs:57
    value: 0.01
  - key: SouthIceShield.Tick.2
    label: 'Tick / int stage = ratio > 2f / 3f ? 0 : ratio > 1f / 3f ? 1 : 2;'
