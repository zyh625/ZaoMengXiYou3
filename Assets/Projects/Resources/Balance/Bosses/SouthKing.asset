    value: 0.01
  - key: SouthKingCombat.Cooldown.1
    label: 'Cooldown / ? Mathf.Max(0f, skillCooldowns[index]) : 10f) * RebirthCooldownMultiplier;'
    source: Assets/Projects/Scripts/Boss/SouthKing/SouthKingCombat.cs:74
    value: 10
  - key: SouthKingCombat.EnterCounterGuard.1
    label: EnterCounterGuard / Counter = CounterStage.Guard; guardUntil = Time.time
      + Mathf.Max(0.01f, counterWait);
    source: Assets/Projects/Scripts/Boss/SouthKing/SouthKingCombat.cs:132
    value: 0.01
  - key: SouthKingCombat.ProtectCounter.1
    label: ProtectCounter / public void ProtectCounter(float duration) => health?.GrantInvincibility(this,
      Mathf.Max(0.1f, duration));
    source: Assets/Projects/Scripts/Boss/SouthKing/SouthKingCombat.cs:141
    value: 0.1
  - key: SouthKingCombat.BlockDamage.1
    label: BlockDamage / if (Mathf.Abs(sourceX) > 0.01f) AttackFaceRight = sourceX
      > 0f;
    source: Assets/Projects/Scripts/Boss/SouthKing/SouthKingCombat.cs:150
    value: 0.01
  - key: SouthKingCombat.HitCounter.1
    label: 'HitCounter / Vector3 center = transform.position + Vector3.right * (AttackFaceRight
      ? 1f : -1f) * counterHitSize.x * 0.4f;'
    source: Assets/Projects/Scripts/Boss/SouthKing/SouthKingCombat.cs:168
    value: 0.4
  - key: SouthKingCombat.HitCounter.2
    label: HitCounter / Bounds area = new(center, new Vector3(Mathf.Max(0.1f, counterHitSize.x),
      Mathf.Max(0.1f, counterHitSize.y), 1f));
    source: Assets/Projects/Scripts/Boss/SouthKing/SouthKingCombat.cs:169
    value: 0.1
  - key: SouthKingCombat.HitCounter.3
    label: HitCounter / Bounds area = new(center, new Vector3(Mathf.Max(0.1f, counterHitSize.x),
      Mathf.Max(0.1f, counterHitSize.y), 1f));
    source: Assets/Projects/Scripts/Boss/SouthKing/SouthKingCombat.cs:169
    value: 0.1
  - key: SouthKingCombat.AddFrost.1
    label: AddFrost / if (frost >= MaxFrost) { frostActive = true; frostUntil = Time.time
      + Mathf.Max(0.01f, frostDuration); }
    source: Assets/Projects/Scripts/Boss/SouthKing/SouthKingCombat.cs:204
    value: 0.01
  - key: SouthKingController.OnCounterRecognized.1
    label: OnCounterRecognized / combat.ProtectCounter(counterRiposte.sprites.Length
      / Mathf.Max(1f, counterRiposte.fps) + Time.fixedDeltaTime * 2f)
