    value: 0.01
  - key: SouthIceShield.Place.1
    label: 'Place / float height = body.size.y * (bodyCollider != null ? Mathf.Max(0.1f,
      bodyHeightRatio) : 1f);'
    source: Assets/Projects/Scripts/Boss/SouthKing/SouthIceShield.cs:26
    value: 0.1
  - key: SouthIceShield.Place.2
    label: Place / transform.position = new Vector3(body.center.x, body.min.y + height
      * 0.5f, owner.transform.position.z);
    source: Assets/Projects/Scripts/Boss/SouthKing/SouthIceShield.cs:27
    value: 0.5
  - key: SouthIceShield.Place.3
    label: Place / float size = height * Mathf.Max(0.1f, sizeRatio);
