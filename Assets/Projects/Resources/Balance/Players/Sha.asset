  numbers:
  - key: BoomerangManager.FixedUpdate.1
    label: FixedUpdate / Vector2 next = Vector2.MoveTowards(position, destination,
      Mathf.Max(0.01f, speed) * Time.fixedDeltaTime);
    source: Assets/Projects/Scripts/Player/Sha/BoomerangManager.cs:58
    value: 0.01
  - key: BoomerangManager.FixedUpdate.2
    label: FixedUpdate / if ((next - destination).sqrMagnitude > 0.000001f) return;
    source: Assets/Projects/Scripts/Player/Sha/BoomerangManager.cs:63
    value: 0.000001
  - key: BoomerangManager.MoveEnemies.1
    label: MoveEnemies / Vector2 next = Vector2.MoveTowards(item.Value, origin, Mathf.Max(0.01f,
      returnSpeed) * Time.fixedDeltaTime);
    source: Assets/Projects/Scripts/Player/Sha/BoomerangManager.cs:154
    value: 0.01
  - key: QuicksandManager.FixedUpdate.1
    label: FixedUpdate / float interval = Mathf.Max(0.01f, poisonInterval);
