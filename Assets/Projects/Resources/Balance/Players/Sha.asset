    value: 0.01
  - key: QuicksandManager.FixedUpdate.2
    label: FixedUpdate / float distanceRatio = Mathf.Clamp01(Mathf.Abs(deltaX) /
      Mathf.Max(0.01f, radius));
    source: Assets/Projects/Scripts/Player/Sha/QuicksandManager.cs:73
    value: 0.01
  - key: SkullManager.FindTarget.1
    label: FindTarget / if (count < bestCount || count == bestCount && distance <
      bestDistance - 0.0001f)
    source: Assets/Projects/Scripts/Player/Sha/SkullManager.cs:128
    value: 0.0001
  - key: SkullManager.FindTarget.2
    label: FindTarget / else if (count == bestCount && Mathf.Abs(distance - bestDistance)
      <= 0.0001f)
    source: Assets/Projects/Scripts/Player/Sha/SkullManager.cs:135
    value: 0.0001
  - key: ShaEffectUtility.GetBounds.1
    label: 'GetBounds / ? enemy.BodyCollider.bounds : new Bounds(enemy.transform.position,
      Vector3.one * 0.5f);'
    source: Assets/Projects/Scripts/Player/Sha/SkullManager.cs:189
    value: 0.5
  - key: ShaEffectUtility.SegmentHits.1
    label: SegmentHits / bounds.Expand(Mathf.Max(0f, radius) * 2f);
