    value: 0.025
  - key: RedChainPull.Begin.1
    label: 'Begin / float half = ownBox != null ? ownBox.bounds.extents.x : 0.5f;'
    source: Assets/Projects/Scripts/Enemy/RedChain/RedChainPull.cs:30
    value: 0.5
  - key: RedChainPull.Begin.2
    label: Begin / float faceX = enemyBox != null ? enemyBox.bounds.center.x + side
      * (enemyBox.bounds.extents.x + half + 0.1f)
    source: Assets/Projects/Scripts/Enemy/RedChain/RedChainPull.cs:31
    value: 0.1
  - key: RedChainPull.Begin.3
    label: 'Begin / : owner.transform.position.x + side * 1.5f;'
    source: Assets/Projects/Scripts/Enemy/RedChain/RedChainPull.cs:32
    value: 1.5
  - key: RedChainPull.FixedUpdate.1
    label: FixedUpdate / if (Vector2.Dot(hits[i].normal, direction) >= -0.01f) continue;
    source: Assets/Projects/Scripts/Enemy/RedChain/RedChainPull.cs:68
    value: 0.01
  - key: RedChainPull.FixedUpdate.2
    label: FixedUpdate / ending = blocked || elapsed >= Duration - 0.0001f || step
      <= 0.0001f;
    source: Assets/Projects/Scripts/Enemy/RedChain/RedChainPull.cs:75
    value: 0.0001
  - key: RedChainPull.FixedUpdate.3
    label: FixedUpdate / ending = blocked || elapsed >= Duration - 0.0001f || step
      <= 0.0001f;
    source: Assets/Projects/Scripts/Enemy/RedChain/RedChainPull.cs:75
    value: 0.0001
  - key: RedChainPull.Cancel.1
    label: Cancel / if (pulling && body != null && Mathf.Abs(body.linearVelocityX
      - lastVelocity) < 0.001f)
    source: Assets/Projects/Scripts/Enemy/RedChain/RedChainPull.cs:80
    value: 0.001
  - key: RedChainShockWaveEmitter.Emit.1
    label: 'Emit / Vector2 position = new(source.transform.position.x + (source.AttackFaceRight
      ? 3f : -3f), feetY);'
    source: Assets/Projects/Scripts/Enemy/RedChain/RedChainShockWaveEmitter.cs:10
    value: 3
