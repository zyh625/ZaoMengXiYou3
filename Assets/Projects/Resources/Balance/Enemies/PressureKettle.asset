    value: 0.5
  - key: PressureKettleEffect.FixedUpdate.7
    label: FixedUpdate / else { if (Mathf.Abs(hit.normal.x) > 0.1f) velocity.x =
      0f; if (hit.normal.y < 0f) velocity.y = Mathf.Min(0f, veloc
    source: Assets/Projects/Scripts/Enemy/PressureKettle/PressureKettleEffect.cs:138
    value: 0.1
  - key: PressureKettleEffect.FixedUpdate.8
    label: FixedUpdate / visual.transform.localScale = Vector3.one * (bombRadius
      * 2f / nativeWidth);
    source: Assets/Projects/Scripts/Enemy/PressureKettle/PressureKettleEffect.cs:146
    value: 2
  - key: PressureKettleEffect.FixedUpdate.9
    label: FixedUpdate / visual.transform.localPosition = (Vector3)(explosionOffset
