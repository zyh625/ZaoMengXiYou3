    value: 2
  - key: PressureKettleEffect.FixedUpdate.1
    label: FixedUpdate / while (TickCount < steamTicks && Time.time + 0.0001f >=
      nextTick)
    source: Assets/Projects/Scripts/Enemy/PressureKettle/PressureKettleEffect.cs:111
    value: 0.0001
  - key: PressureKettleEffect.FixedUpdate.2
    label: FixedUpdate / Vector2 from = transform.position, delta = velocity * dt
      + Vector2.down * (9f * dt * dt);
    source: Assets/Projects/Scripts/Enemy/PressureKettle/PressureKettleEffect.cs:123
    value: 9
  - key: PressureKettleEffect.FixedUpdate.3
    label: FixedUpdate / velocity += Vector2.down * (18f * dt);
