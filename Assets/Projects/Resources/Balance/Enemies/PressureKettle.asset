    value: 0.12
  - key: PressureKettleEffect.Launch.2
    label: Launch / RaycastHit2D floor = Physics2D.Raycast(aim, Vector2.down, 30f,
      1 << 6);
    source: Assets/Projects/Scripts/Enemy/PressureKettle/PressureKettleEffect.cs:79
    value: 30
  - key: PressureKettleEffect.Launch.3
    label: Launch / if (floor.collider != null) aim.y = floor.point.y + 0.12f;
    source: Assets/Projects/Scripts/Enemy/PressureKettle/PressureKettleEffect.cs:80
    value: 0.12
  - key: PressureKettleEffect.Launch.4
    label: Launch / const float flightTime = 0.9f, gravity = 18f;
    source: Assets/Projects/Scripts/Enemy/PressureKettle/PressureKettleEffect.cs:81
    value: 0.9
  - key: PressureKettleEffect.Launch.5
    label: Launch / const float flightTime = 0.9f, gravity = 18f;
    source: Assets/Projects/Scripts/Enemy/PressureKettle/PressureKettleEffect.cs:81
    value: 18
  - key: PressureKettleEffect.Launch.6
    label: Launch / (aim.y - transform.position.y + gravity * flightTime * flightTime
      / 2f) / flightTime);
    source: Assets/Projects/Scripts/Enemy/PressureKettle/PressureKettleEffect.cs:83
    value: 2
  - key: PressureKettleEffect.Launch.7
    label: Launch / expiresAt = Time.time + 8f;
    source: Assets/Projects/Scripts/Enemy/PressureKettle/PressureKettleEffect.cs:84
    value: 8
  - key: PressureKettleEffect.BeginBurst.1
    label: BeginBurst / transform.position = (Vector2)source.transform.position +
