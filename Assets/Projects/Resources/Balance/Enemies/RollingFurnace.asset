  numbers:
  - key: RollingFurnaceCombat.VentReady.1
    label: VentReady / public bool VentReady => accumulatedDamage >= 40f && Time.time
      >= ventReadyAt;
    source: Assets/Projects/Scripts/Enemy/RollingFurnace/RollingFurnaceCombat.cs:13
    value: 40
  - key: RollingFurnaceCombat.Land.1
    label: Land / slamBox.gameObject.SetActive(false); shockwaves.Emit(position,
      5f);
    source: Assets/Projects/Scripts/Enemy/RollingFurnace/RollingFurnaceCombat.cs:39
    value: 5
  - key: RollingFurnaceCombat.BeginVent.1
    label: BeginVent / health.SetDamageMultiplier(this, .2f); health.SetSuperArmor(this,
      true); return true;
    source: Assets/Projects/Scripts/Enemy/RollingFurnace/RollingFurnaceCombat.cs:46
    value: 0.2
  - key: RollingFurnaceCombat.AdvanceVent.1
    label: AdvanceVent / if (now >= ventStartedAt + 3f) { EndVent(); return; }
    source: Assets/Projects/Scripts/Enemy/RollingFurnace/RollingFurnaceCombat.cs:51
    value: 3
  - key: RollingFurnaceCombat.AdvanceVent.2
    label: AdvanceVent / if (now >= ventStartedAt + 2f && Vent == VentPhase.Closed)
    source: Assets/Projects/Scripts/Enemy/RollingFurnace/RollingFurnaceCombat.cs:52
    value: 2
  - key: RollingFurnaceCombat.AdvanceVent.3
    label: AdvanceVent / Vent = VentPhase.Open; health.SetDamageMultiplier(this,
      1.5f);
    source: Assets/Projects/Scripts/Enemy/RollingFurnace/RollingFurnaceCombat.cs:54
    value: 1.5
  - key: RollingFurnaceController.ProcessSpecialState.1
    label: ProcessSpecialState / if (distance >= 3f && distance <= 8f && BeginRoll(movement.DeltaX))
      return true;
    source: Assets/Projects/Scripts/Enemy/RollingFurnace/RollingFurnaceController.cs:61
    value: 3
  - key: RollingFurnaceController.ProcessSpecialState.2
    label: ProcessSpecialState / if (distance >= 3f && distance <= 8f && BeginRoll(movement.DeltaX))
      return true;
    source: Assets/Projects/Scripts/Enemy/RollingFurnace/RollingFurnaceController.cs:61
    value: 8
  - key: RollingFurnaceController.ProcessSpecialState.3
    label: ProcessSpecialState / if (distance >= 2f && distance <= 4f && BeginSlam())
      return true;
    source: Assets/Projects/Scripts/Enemy/RollingFurnace/RollingFurnaceController.cs:62
    value: 2
  - key: RollingFurnaceController.ProcessSpecialState.4
    label: ProcessSpecialState / if (distance >= 2f && distance <= 4f && BeginSlam())
      return true;
    source: Assets/Projects/Scripts/Enemy/RollingFurnace/RollingFurnaceController.cs:62
    value: 4
  - key: RollingFurnaceController.ProcessSpecialState.5
    label: ProcessSpecialState / if (distance < 2f)
    source: Assets/Projects/Scripts/Enemy/RollingFurnace/RollingFurnaceController.cs:63
    value: 2
  - key: RollingFurnaceController.ProcessSpecialState.6
    label: ProcessSpecialState / movement.HoldStill(); Pose(RollCharge, (int)(elapsed
      * 16f));
    source: Assets/Projects/Scripts/Enemy/RollingFurnace/RollingFurnaceController.cs:77
    value: 16
  - key: RollingFurnaceController.ProcessSpecialState.7
    label: ProcessSpecialState / if (elapsed >= .5f) { movement.BeginRoll(direction);
      combat.OpenRoll(false); Enter(FurnaceAction.Rolling); }
    source: Assets/Projects/Scripts/Enemy/RollingFurnace/RollingFurnaceController.cs:78
    value: 0.5
  - key: RollingFurnaceController.ProcessSpecialState.8
    label: ProcessSpecialState / Pose(RollCharge, 8 + (int)(elapsed * 24f) % 4);
    source: Assets/Projects/Scripts/Enemy/RollingFurnace/RollingFurnaceController.cs:81
    value: 24
  - key: RollingFurnaceController.ProcessSpecialState.9
    label: ProcessSpecialState / if (!rebound && movement.Remaining > .001f)
    source: Assets/Projects/Scripts/Enemy/RollingFurnace/RollingFurnaceController.cs:91
    value: 0.001
  - key: RollingFurnaceController.ProcessSpecialState.10
    label: ProcessSpecialState / Pose(RollCharge, 12 + (int)(elapsed * 16f)); if
      (elapsed >= .25f) Finish(); break;
    source: Assets/Projects/Scripts/Enemy/RollingFurnace/RollingFurnaceController.cs:100
    value: 16
  - key: RollingFurnaceController.ProcessSpecialState.11
    label: ProcessSpecialState / Pose(RollCharge, 12 + (int)(elapsed * 16f)); if
      (elapsed >= .25f) Finish(); break;
    source: Assets/Projects/Scripts/Enemy/RollingFurnace/RollingFurnaceController.cs:100
    value: 0.25
  - key: RollingFurnaceController.ProcessSpecialState.12
