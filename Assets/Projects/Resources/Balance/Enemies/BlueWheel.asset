  numbers:
  - key: BlueBoomearng.FlySpeed.1
    label: FlySpeed / public float FlySpeed => Mathf.Max(0.01f, flySpeed);
    source: Assets/Projects/Scripts/Enemy/BlueWheel/BlueBoomearng.cs:30
    value: 0.01
  - key: BlueBoomearng.FixedUpdate.1
    label: FixedUpdate / step = Mathf.Min(step, Mathf.Max(0f, Mathf.Max(0.1f, outboundDistance)
      - travelled));
    source: Assets/Projects/Scripts/Enemy/BlueWheel/BlueBoomearng.cs:114
    value: 0.1
  - key: BlueBoomearng.FixedUpdate.2
    label: FixedUpdate / if (hiddenCast && (reachedEdge || travelled >= Mathf.Max(0.1f,
      outboundDistance)))
    source: Assets/Projects/Scripts/Enemy/BlueWheel/BlueBoomearng.cs:129
    value: 0.1
  - key: BlueBoomearng.FixedUpdate.3
    label: FixedUpdate / BeginReturn(Vector2.Distance(to, TargetPosition) / Mathf.Max(0.01f,
      returnSpeed), true);
    source: Assets/Projects/Scripts/Enemy/BlueWheel/BlueBoomearng.cs:130
    value: 0.01
  - key: BlueBoomearng.MakeFree.1
    label: 'MakeFree / direction = new Vector2(Mathf.Abs(lastDirection.x) > 0.001f
      ? Mathf.Sign(lastDirection.x) : Mathf.Sign(direction.x)'
    source: Assets/Projects/Scripts/Enemy/BlueWheel/BlueBoomearng.cs:159
    value: 0.001
  - key: BlueBoomearng.SaveDirection.1
    label: SaveDirection / if (delta.sqrMagnitude > 0.000001f) lastDirection = delta.normalized;
    source: Assets/Projects/Scripts/Enemy/BlueWheel/BlueBoomearng.cs:166
    value: 0.000001
  - key: BlueBoomearng.SaveDirection.2
    label: SaveDirection / if (sr != null && Mathf.Abs(lastDirection.x) > 0.001f)
      sr.flipX = (lastDirection.x > 0f) != sourceFacesRight;
    source: Assets/Projects/Scripts/Enemy/BlueWheel/BlueBoomearng.cs:167
    value: 0.001
  - key: BlueBoomearng.ClampToBounds.1
    label: ClampToBounds / if (left > right) left = right = (bounds.x + bounds.y)
      * 0.5f - offset;
    source: Assets/Projects/Scripts/Enemy/BlueWheel/BlueBoomearng.cs:180
    value: 0.5
  - key: BlueBoomearng.CheckPlayerHit.1
    label: CheckPlayerHit / if (!target.Contains(start) && (delta.sqrMagnitude <=
      0.000001f
    source: Assets/Projects/Scripts/Enemy/BlueWheel/BlueBoomearng.cs:199
    value: 0.000001
  - key: BlueMovement.PatrolHidden.1
    label: PatrolHidden / if ((transform.position.x - playerX) * patrolSide < -0.5f)
    source: Assets/Projects/Scripts/Enemy/BlueWheel/BlueMovement.cs:39
    value: 0.5
  - key: BlueMovement.PatrolHidden.2
    label: PatrolHidden / float near = playerX + patrolSide * Mathf.Max(0.5f, hiddenDistance);
    source: Assets/Projects/Scripts/Enemy/BlueWheel/BlueMovement.cs:44
    value: 0.5
  - key: BlueMovement.PatrolHidden.3
    label: PatrolHidden / float far = playerX + patrolSide * (Mathf.Max(0.5f, hiddenDistance)
      + Mathf.Max(0.2f, patrolWidth));
    source: Assets/Projects/Scripts/Enemy/BlueWheel/BlueMovement.cs:45
    value: 0.5
  - key: BlueMovement.PatrolHidden.4
    label: PatrolHidden / float far = playerX + patrolSide * (Mathf.Max(0.5f, hiddenDistance)
      + Mathf.Max(0.2f, patrolWidth));
    source: Assets/Projects/Scripts/Enemy/BlueWheel/BlueMovement.cs:45
    value: 0.2
  - key: BlueMovement.PatrolHidden.5
    label: 'PatrolHidden / float margin = BodyCollider != null ? BodyCollider.bounds.extents.x
      + 0.2f : 1f;'
    source: Assets/Projects/Scripts/Enemy/BlueWheel/BlueMovement.cs:48
    value: 0.2
  - key: BlueMovement.PatrolHidden.6
    label: PatrolHidden / if (Mathf.Abs(distance) <= Mathf.Max(0.02f, turnTolerance))
    source: Assets/Projects/Scripts/Enemy/BlueWheel/BlueMovement.cs:59
    value: 0.02
  - key: BlueMovement.PatrolHidden.7
    label: PatrolHidden / if (Mathf.Abs(distance) <= Mathf.Max(0.02f, turnTolerance))
    source: Assets/Projects/Scripts/Enemy/BlueWheel/BlueMovement.cs:65
    value: 0.02
  - key: BlueMovement.PatrolHidden.8
    label: PatrolHidden / float limit = distance / Mathf.Max(0.0001f, Time.fixedDeltaTime);
    source: Assets/Projects/Scripts/Enemy/BlueWheel/BlueMovement.cs:76
    value: 0.0001
  - key: BlueWheelCombat.ShadowInterval.1
    label: ShadowInterval / public float ShadowInterval => Mathf.Max(0.05f, shadowInterval);
    source: Assets/Projects/Scripts/Enemy/BlueWheel/BlueWheelCombat.cs:33
    value: 0.05
  - key: BlueWheelCombat.EmitWheels.1
    label: 'EmitWheels / float delay = hidden && i > 0 ? Mathf.Max(0f, doubleSpacing)
      / Mathf.Max(0.01f, wheelPrefab.FlySpeed) : 0f;'
    source: Assets/Projects/Scripts/Enemy/BlueWheel/BlueWheelCombat.cs:115
    value: 0.01
  - key: BlueWheelController.BuildHiddenLoop.1
    label: 'BuildHiddenLoop / fps = count / (combat != null ? combat.ShadowInterval
      : 1.5f) };'
    source: Assets/Projects/Scripts/Enemy/BlueWheel/BlueWheelController.cs:23
    value: 1.5
  - key: BlueWheelController.SkillOver.1
    label: 'SkillOver / combat.BeginReturn(returning != null ? returning.fps : 16f);'
    source: Assets/Projects/Scripts/Enemy/BlueWheel/BlueWheelController.cs:82
    value: 16
