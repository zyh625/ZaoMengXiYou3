    source: Assets/Projects/Scripts/Enemy/GreenHammer/GreenHammerCombat.cs:70
    value: 2
  - key: GreenHammerCombat.SampleFrame.8
    label: SampleFrame / shockwave.Emit(this,position,2f,true,segmentScale);
    source: Assets/Projects/Scripts/Enemy/GreenHammer/GreenHammerCombat.cs:71
    value: 2
  - key: GreenHammerMovement.BeginLeap.1
