    value: 2
  - key: GreenHammerCombat.SampleFrame.1
    label: SampleFrame / if(Attack==1)shockwave.Emit(this,GroundPoint(transform.position.x),6f,false,DamageMultiplier);
    source: Assets/Projects/Scripts/Enemy/GreenHammer/GreenHammerCombat.cs:58
    value: 6
  - key: GreenHammerCombat.SampleFrame.2
    label: SampleFrame / SegmentsEmitted=1;segmentTimes[0]=Time.time;pending=2;nextSegment=Time.time+0.15f;
    source: Assets/Projects/Scripts/Enemy/GreenHammer/GreenHammerCombat.cs:62
    value: 0.15
  - key: GreenHammerCombat.SampleFrame.3
    label: SampleFrame / shockwave.Emit(this,GroundPoint(groundOrigin.x+(groundRight?2f:-2f)),2f,false,segmentScale);
    source: Assets/Projects/Scripts/Enemy/GreenHammer/GreenHammerCombat.cs:63
    value: 2
  - key: GreenHammerCombat.SampleFrame.4
    label: SampleFrame / shockwave.Emit(this,GroundPoint(groundOrigin.x+(groundRight?2f:-2f)),2f,false,segmentScale);
