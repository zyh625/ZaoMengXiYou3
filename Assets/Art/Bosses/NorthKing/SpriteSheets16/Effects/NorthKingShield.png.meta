  pSDRemoveMatte: 0
  userData: '{"key": "NorthKingShield", "label": "NorthKing \u72ec\u7acb\u62a4\u7f69", "owner": "NorthKing", "loop": true, "fps": 12, "duration": 0, "sort": 20, "action": "Effect: GUARD SHIELD AURA ONLY, 16-frame seamless loop. A translucent jade-green celestial protective dome/oval barrier in three-quarter perspective, thin gold rim and restrained cloud-scroll energy drifting around edge. Hollow/translucent center is genuinely transparent so a character can be independently composited behind it. No king, face, body, armor, umbrella or physical shield prop. Stable full oval/dome footprint and center in every frame. F1-5 rim pulses brighter, F6-10 small green/gold edge glints drift, F11-15 settle, F16 matchesF1. No beams, explosions, scenery or opaque colored rectangle. Entire barrier and glow fit inside each cell."}'
  assetBundleName: 
  assetBundleVariant: 
