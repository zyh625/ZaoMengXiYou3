  userData: '{"key": "NorthKingRainCurtain", "label": "NorthKing \u72ec\u7acb\u96e8\u5e55", "owner": "NorthKing", "loop": true, "fps": 16, "duration": 2, "sort": 10, "action": "Effect: RAIN CURTAIN VOLUME ONLY, 16-frame continuous loop. A compact rectangular vertical shower of thin jade-green/gold luminous needle-like drops falling straight DOWN, with a few tiny pale-mint droplets near the bottom, all fading out before cell edges. No umbrella, canopy, character, cloud, sky, ground plane, impact floor or environment. Frame progression clearly shows the same spaced drops traveling downward and new drops entering/fading at top, seamless F16 toF1. Entire rain volume stays fixed in local bounds and center; all streak ends and particles inside the cell with 32px gutters. This is a standalone downward projectile-rain visual volume, not part of any king sprite."}'
  assetBundleName: 
  assetBundleVariant: 
